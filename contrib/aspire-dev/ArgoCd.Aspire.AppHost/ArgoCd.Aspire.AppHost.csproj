<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>argocd-aspire-kind-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArgoCd.Aspire.Hosting.Kind\ArgoCd.Aspire.Hosting.Kind.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.4.6" />
  </ItemGroup>

  <!--
    Exclude the sibling test project from this AppHost's compile glob. The
    Aspire.AppHost.Sdk defaults to **/*.cs; without this exclusion it would try
    to compile the xunit-dependent test files as part of the AppHost itself.
  -->
  <ItemGroup>
    <Compile Remove="..\ArgoCd.Aspire.AppHost.Tests\**\*.cs" />
  </ItemGroup>

</Project>
