<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>
      Vendored .NET Aspire hosting integration for Kind (Kubernetes in Docker) clusters,
      used by the contrib/aspire-dev Argo CD development environment. See NOTICE.md for
      provenance. Not published as a NuGet package.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.6" />
  </ItemGroup>

</Project>
