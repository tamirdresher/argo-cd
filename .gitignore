.idea/
.DS_Store
.run/
vendor/
dist/*
ui/dist/app/*
!ui/dist/app/gitkeep
site/
*.iml
.tilt-bin/
# delve debug binaries
cmd/**/debug
debug.test
coverage.out
test-results
.scannerwork
.scratch
# pnpm SBOM helper (hack/generate-ui-pnpm-sbom.sh) download cache — remove this line when that script is deleted.
hack/.cache/
node_modules/
.kube/
./test/cmp/*.sock
.envrc.remote
.mirrord/
.*.swp
rerunreport.txt

# AI tools support
CLAUDE.local.md

# ignore built binaries
cmd/argocd/argocd
cmd/argocd-application-controller/argocd-application-controller
cmd/argocd-repo-server/argocd-repo-server
cmd/argocd-server/argocd-server

# ignore generated `.argocd-helm-dep-up` marker file; this should not be committed to git
reposerver/repository/testdata/**/.argocd-helm-dep-up
.claude

# contrib/aspire-dev (.NET Aspire + Kind local dev environment)
contrib/aspire-dev/**/bin/
contrib/aspire-dev/**/obj/
contrib/aspire-dev/**/*.user
# Aspire CLI local state (records the last-used AppHost path on this machine)
/aspire.config.json

# Delve debug binaries left behind by 'dlv debug' / VS Code F5 sessions
__debug_bin*
